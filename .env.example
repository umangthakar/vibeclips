# QuizStar — copy to .env.local and fill in from your Supabase project.
# Dashboard -> Settings -> Data API (URL) and Settings -> API Keys (keys).

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Secret key, `sb_secret_...` (successor to the legacy service_role key).
# Bypasses RLS — server-side ONLY. Never prefix it with NEXT_PUBLIC_ and never
# import it into a Client Component.
SUPABASE_SECRET_KEY=

# Public key, `sb_publishable_...` (successor to the legacy anon key).
# No app code uses this — QuizStar has no browser-side Supabase client. It exists
# so `npm run db:check` can prove the public key really can't read any table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used to build shareable quiz links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the influencer session JWT. At least 32 characters. Rotating it logs
# everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
